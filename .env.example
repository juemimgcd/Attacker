APP__APP_NAME=attacker
APP__APP_ENV=local
APP__DEBUG=true
APP__API_PREFIX=

LOG__LOG_LEVEL=INFO
LOG__LOG_DIR=logs
LOG__LOG_ROTATION=10 MB
LOG__LOG_RETENTION=14 days
LOG__STRUCTURED_JSON=false

DATABASE__URL=sqlite+aiosqlite:///data/attacker.sqlite3
DATABASE__ECHO=false
DATABASE__AUTO_CREATE_SCHEMA=true
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_TIMEOUT_SECONDS=30
DATABASE__POOL_RECYCLE_SECONDS=1800
DATABASE__POOL_PRE_PING=true
DATABASE__CONNECT_TIMEOUT_SECONDS=10

CHECKPOINT__DATABASE_PATH=data/langgraph_checkpoints.sqlite3
# Production: postgresql://user:password@postgres:5432/attacker
CHECKPOINT__URL=

# Optional. When set, all run, approval, replay, and test endpoints require X-API-Key.
SECURITY__API_KEY=
# Optional locally; required in production for the X-Metrics-Key header.
SECURITY__METRICS_API_KEY=

WORKER__ENABLED=true
WORKER__CONCURRENCY=2
WORKER__POLL_SECONDS=1
WORKER__LEASE_SECONDS=120
WORKER__HEARTBEAT_SECONDS=20
WORKER__MAX_ATTEMPTS=3
WORKER__SHUTDOWN_GRACE_SECONDS=60

# Provider Instance references may use env:NAME locally. Production must use file: or vault:.
SECRETS__BACKEND=environment
SECRETS__ALLOW_ENVIRONMENT_REFERENCES=true
SECRETS__FILE_ROOT=run/secrets
SECRETS__VAULT_ADDRESS=
SECRETS__VAULT_MOUNT=secret
SECRETS__VAULT_NAMESPACE=
SECRETS__VAULT_TOKEN_ENV=VAULT_TOKEN
SECRETS__VAULT_TOKEN_FILE=
SECRETS__VAULT_TIMEOUT_SECONDS=5

OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__TRACING_ENABLED=false
OBSERVABILITY__OTLP_ENDPOINT=
OBSERVABILITY__OTLP_HEADERS=
OBSERVABILITY__SERVICE_NAME=attacker
OBSERVABILITY__DEPLOYMENT_ENVIRONMENT=local
OBSERVABILITY__REQUEST_ID_HEADER=X-Request-ID

# Local, offline equipment catalog. Untrusted code remains disabled by default.
EQUIPMENT__ROOT=equipment
EQUIPMENT__CONTRACTS_ROOT=contracts
EQUIPMENT__WORKSPACE_ROOT=data/equipment-workspaces
EQUIPMENT__ARCHIVE_ROOT=data/equipment-archive
EQUIPMENT__ALLOW_EXECUTABLE_PACKAGES=true
EQUIPMENT__REQUIRE_CHECKSUM=true
EQUIPMENT__ALLOW_UNTRUSTED=false
EQUIPMENT__REQUIRE_SIGNATURE=false
EQUIPMENT__TRUST_ROOTS_FILE=conf/equipment_trust_roots.json
EQUIPMENT__REVOCATIONS_FILE=conf/equipment_revocations.json
# Required only when enabling the reviewed Linux container backend for untrusted packages.
EQUIPMENT__SANDBOX_IMAGE=

# Production Compose host-side integration. These values configure mounts/endpoints,
# not application identity. Keep the referenced directories and files operator-owned.
ATTACKER_PROVIDER_SECRETS_DIR=./deploy/provider-secrets
ATTACKER_ALERT_SECRETS_DIR=./deploy/alert-secrets
ATTACKER_SECRETS_DIR=./deploy/secrets
ATTACKER_VAULT_ADDRESS=https://vault.internal.example
