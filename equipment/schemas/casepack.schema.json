{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attacker Case Pack Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "attacker_compatibility",
    "cases_file"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "casepack.v1",
        "casepack.v2"
      ]
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "attacker_compatibility": {
      "type": "object"
    },
    "cases_file": {
      "type": "string"
    },
    "required_capabilities": {
      "type": "array"
    },
    "tags": {
      "type": "array"
    },
    "trust_level": {
      "enum": [
        "trusted_builtin",
        "trusted_enterprise"
      ]
    }
  },
  "additionalProperties": false
}
